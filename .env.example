# GTD Environment Variables (Optional)

# Google Calendar API Credentials
# Set this if credentials are not in default location (~/.credentials/credentials.json)
# GTD_CREDENTIALS_PATH=/path/to/credentials.json

# Calendar IDs
# Default: "primary" (your primary calendar)
# GTD_CLASS_CALENDAR_ID=your-class-calendar-id@group.calendar.google.com
# GTD_STUDY_CALENDAR_ID=your-study-calendar-id@group.calendar.google.com

# Database Path
# Default: ~/.config/gtd/gtd.db
# GTD_DB_PATH=/custom/path/to/gtd.db

# Config Path
# Default: ~/.config/gtd/config.json
# GTD_CONFIG_PATH=/custom/path/to/config.json

# Study Scheduler Script Path
# Default: ~/Scripts/study_scheduler.go
# GTD_PLAN_SCRIPT=/path/to/study_scheduler.go

# Sync Interval (seconds)
# Default: 300 (5 minutes)
# GTD_SYNC_INTERVAL=300

# Pomodoro Settings
# GTD_POMODORO_WORK_MINS=25
# GTD_POMODORO_SHORT_BREAK=5
# GTD_POMODORO_LONG_BREAK=15

# Testing (for integration tests only)
# GTD_TEST_CREDENTIALS=/path/to/test/credentials.json
# GTD_TEST_CLASS_CAL=test-class-calendar-id
# GTD_TEST_STUDY_CAL=test-study-calendar-id

# Debug Mode
# GTD_DEBUG=false

# Log Level (debug, info, warn, error)
# GTD_LOG_LEVEL=info
